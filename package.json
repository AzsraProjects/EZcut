{
  "name": "ezcut",
  "version": "0.1.0",
  "description": "Logiciel de montage vidéo simple et rapide",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:export": "npm run build && node scripts/test-export.mjs",
    "icon": "node scripts/dev.mjs --script scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "author": "AzsraProjects",
  "homepage": "https://github.com/AzsraProjects/EZcut",
  "build": {
    "appId": "com.azsraprojects.ezcut",
    "productName": "EZcut",
    "copyright": "EZcut — GPL-3.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
        "to": "bin/ffprobe.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "licenses/FFmpeg.LICENSE.txt"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "THIRD-PARTY.md",
        "to": "licenses/THIRD-PARTY.md"
      },
      {
        "from": "LICENSE",
        "to": "licenses/EZcut.LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "EZcut-Setup-${version}.exe",
      "shortcutName": "EZcut"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AzsraProjects",
        "repo": "EZcut"
      }
    ]
  }
}
